# Android fstab for OrangePi-3B (RK3566)
# <src>                           <mnt>           <type>  <mnt_flags>                <fs_mgr_flags>

/dev/block/by-name/boot           /boot           emmc    defaults                   recoveryonly,first_stage_mount
/dev/block/by-name/vendor_boot    /vendor_boot    emmc    defaults                   recoveryonly,first_stage_mount
/dev/block/by-name/misc           /misc           emmc    defaults                   defaults
/dev/block/by-name/metadata       /metadata       ext4    noatime,nosuid,nodev       wait,check,formattable,first_stage_mount

system                            /system         ext4    noatime,ro,errors=panic    wait,logical,first_stage_mount,slotselect
vendor                            /vendor         ext4    noatime,ro,errors=panic    wait,logical,first_stage_mount,slotselect
product                           /product        ext4    noatime,ro,errors=panic    wait,logical,first_stage_mount,slotselect

/dev/block/by-name/cache          /cache          f2fs    noatime,nosuid,nodev       wait,check,formattable
/dev/block/by-name/userdata       /data           f2fs    noatime,nosuid,nodev,discard,reserve_root=32768,resgid=1065,fsync_mode=nobarrier,checkpoint_merge latemount,wait,check,fileencryption=software,keydirectory=/metadata/vold/metadata_encryption,quota,reservedsize=128M
