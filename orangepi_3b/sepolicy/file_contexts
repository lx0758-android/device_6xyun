# 块设备（非 A/B，单份分区）
/dev/block/platform/fe310000\.mmc/by-name/boot         u:object_r:boot_block_device:s0
/dev/block/platform/fe310000\.mmc/by-name/vendor_boot  u:object_r:boot_block_device:s0
/dev/block/platform/fe310000\.mmc/by-name/dtbo         u:object_r:dtbo_block_device:s0
/dev/block/platform/fe310000\.mmc/by-name/vbmeta       u:object_r:vbmeta_block_device:s0
/dev/block/platform/fe310000\.mmc/by-name/misc         u:object_r:misc_block_device:s0
/dev/block/platform/fe310000\.mmc/by-name/cache        u:object_r:cache_block_device:s0
/dev/block/platform/fe310000\.mmc/by-name/super        u:object_r:super_block_device:s0
/dev/block/platform/fe310000\.mmc/by-name/userdata     u:object_r:userdata_block_device:s0

# 厂商固件
/(vendor|system/vendor)/firmware(/.*)? u:object_r:vendor_firmware_file:s0

# 服务可执行文件（系统策略给出的是通用路径，变体需要单独标注）
/(vendor|system/vendor)/bin/hw/android\.hardware\.security\.keymint-service\.nonsecure u:object_r:hal_keymint_default_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.graphics\.allocator-service\.minigbm u:object_r:hal_graphics_allocator_default_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.power-service\.6xyun u:object_r:hal_power_default_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.lights-service\.6xyun u:object_r:hal_light_default_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.health-service\.6xyun u:object_r:hal_health_default_exec:s0

# 图形设备节点（为后续硬件服务阶段预留类型）
/dev/mali0              u:object_r:gpu_device:s0
/dev/dri                u:object_r:gpu_device:s0
/dev/dri/card0          u:object_r:gpu_device:s0
/dev/dri/card1          u:object_r:gpu_device:s0
/dev/dri/renderD128     u:object_r:gpu_device:s0

# Mesa Gallium DRI 驱动由系统进程 dlopen，需要 same_process_hal_file；
# /vendor/lib(64)/egl(/.*)? 已由系统策略统一覆盖，这里只补 libgallium_dri.so
/(vendor|system/vendor)/lib(64)?/libgallium_dri\.so u:object_r:same_process_hal_file:s0

# Mesa 的 u_gralloc 会在应用进程里通过 hw_get_module("gralloc") dlopen
# gralloc.minigbm.so，AIDL mapper 也会在应用进程里 dlopen mapper.minigbm.so；
# 这两个库及其依赖 libminigbm_gralloc.so 同样需要 same_process_hal_file 标签，
# 否则在 enforcing 模式下会被 avc 拒绝（当前 permissive 掩盖了该问题）。
/(vendor|system/vendor)/lib(64)?/hw/gralloc\.minigbm\.so u:object_r:same_process_hal_file:s0
/(vendor|system/vendor)/lib(64)?/hw/mapper\.minigbm\.so u:object_r:same_process_hal_file:s0
/(vendor|system/vendor)/lib(64)?/libminigbm_gralloc\.so u:object_r:same_process_hal_file:s0

# Vulkan HAL 由 libvulkan 在应用进程内 dlopen，同样需要 same_process_hal_file。
# panfrost 是 Mesa PanVK，pastel 是 SwiftShader 回退实现。
/(vendor|system/vendor)/lib(64)?/hw/vulkan\.(panfrost|pastel)\.so u:object_r:same_process_hal_file:s0
