// OrangePi-3B (RK3566) 平台 Power HAL
//
// 替代 AOSP 的 power-service.example：示例实现的所有 hint 都是空操作，
// 无法参与 cpufreq / uclamp 调度，UI 卡顿时框架拿不到任何性能支撑。

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_binary {
    name: "android.hardware.power-service.6xyun",
    relative_install_path: "hw",
    vendor: true,
    init_rc: ["android.hardware.power-service.6xyun.rc"],
    vintf_fragments: ["android.hardware.power-service.6xyun.xml"],
    srcs: [
        "main.cpp",
        "Power.cpp",
        "PowerHintSession.cpp",
    ],
    shared_libs: [
        "android.hardware.power-V7-ndk",
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "liblog",
        "libutils",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
    ],
}
